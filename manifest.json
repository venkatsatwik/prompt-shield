{
  "manifest_version": 3,
  "name": "PromptShield - GenAI Secret Firewall",
  "version": "1.3.0",
  "description": "Zero-Knowledge GenAI Data Loss Prevention. Intercepts and masks credentials, API keys, and PII in ChatGPT, Claude, and Gemini.",
  "permissions": [
    "storage",
    "activeTab"
  ],
  "icons": {
    "128": "extension/icons/icon.svg"
  },
  "host_permissions": [
    "*://chatgpt.com/*",
    "*://*.openai.com/*",
    "*://claude.ai/*",
    "*://*.anthropic.com/*",
    "*://gemini.google.com/*",
    "*://*.deepseek.com/*",
    "https://prompt-shield-jade.vercel.app/*",
    "http://localhost:*/*"
  ],
  "action": {
    "default_popup": "extension/popup.html",
    "default_title": "PromptShield Security HUD",
    "default_icon": "extension/icons/icon.svg"
  },
  "content_scripts": [
    {
      "matches": [
        "*://chatgpt.com/*",
        "*://*.openai.com/*",
        "*://claude.ai/*",
        "*://*.anthropic.com/*",
        "*://gemini.google.com/*",
        "*://*.deepseek.com/*",
        "https://prompt-shield-jade.vercel.app/*",
        "http://localhost:*/*"
      ],
      "js": [
        "core/detector.js",
        "core/masker.js",
        "extension/content.js"
      ],
      "css": [
        "extension/content.css"
      ],
      "run_at": "document_idle"
    }
  ]
}
